{
  "name": "maqam-protocol-ethonline",
  "main": "worker.mjs",
  "account_id": "4fd82676dc0328c3ae8812138409e980",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    { "pattern": "maqam.ajnasnb.com", "custom_domain": true },
    { "pattern": "ethonline.ajnasnb.com", "custom_domain": true },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
