{
  "name": "maqam-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "npm run compile && vite build",
    "dev": "vite --host 127.0.0.1 --port 5186",
    "start": "vite --host 127.0.0.1 --port 5186",
    "proof": "node scripts/proof.mjs",
    "proof:arc": "node scripts/proof-arc.mjs --agent-proposal",
    "agent": "node scripts/agent-propose.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "ethers": "6.17.0",
    "maqam": "0.3.3"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "ganache": "7.9.2",
    "prettier": "3.9.6",
    "solc": "0.8.37",
    "vite": "8.3.0"
  }
}
